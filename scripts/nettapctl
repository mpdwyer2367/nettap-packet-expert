#!/usr/bin/env bash
set -euo pipefail

project_dir="${NETTAP_HOME:-/opt/nettap/current}"
state_dir="${NETTAP_STATE_DIR:-/var/lib/nettap/state}"
runtime="${project_dir}/appliance/runtime.sh"

require_root() {
  if [[ "$(id -u)" -ne 0 ]]; then
    echo "ERROR: nettapctl $1 requires root." >&2
    exit 3
  fi
}

command_name="${1:-help}"
shift || true
case "$command_name" in
  start|stop|restart)
    require_root "$command_name"
    exec "$runtime" "$command_name" "$@"
    ;;
  status|logs)
    exec "$runtime" "$command_name" "$@"
    ;;
  health)
    exec "${project_dir}/scripts/healthcheck.sh" "$@"
    ;;
  backup)
    require_root backup
    exec "${project_dir}/scripts/appliance-backup.sh" "$@"
    ;;
  restore)
    require_root restore
    exec "${project_dir}/scripts/appliance-restore.sh" "$@"
    ;;
  configure-tls)
    require_root configure-tls
    exec "${project_dir}/scripts/configure-production.sh" "$@"
    ;;
  finalize-admin)
    require_root finalize-admin
    "${project_dir}/scripts/finalize-admin.sh" --confirm
    rm -f "${state_dir}/bootstrap.txt"
    echo "Appliance bootstrap credential record retired."
    ;;
  bootstrap-secret)
    require_root bootstrap-secret
    [[ -t 1 ]] || { echo "ERROR: Refusing to print credentials to a non-interactive output." >&2; exit 4; }
    [[ -f "${state_dir}/bootstrap.txt" ]] || { echo "Bootstrap record is unavailable or retired." >&2; exit 4; }
    cat "${state_dir}/bootstrap.txt"
    ;;
  guest-smoke)
    require_root guest-smoke
    exec "${project_dir}/tests/guest-smoke.sh" "$@"
    ;;
  version)
    if [[ -f /etc/nettap/build-manifest.json ]]; then
      python3 -c 'import json; print(json.load(open("/etc/nettap/build-manifest.json"))["release_version"])'
    else
      sed -n 's/^RELEASE_VERSION=//p' "${project_dir}/.env.example"
    fi
    ;;
  help|*)
    echo "NetTAP appliance administration"
    echo "Commands: start, stop, restart, status, health, logs, backup, restore, configure-tls, finalize-admin, bootstrap-secret, guest-smoke, version"
    ;;
esac
