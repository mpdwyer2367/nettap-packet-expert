#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
command_name="${1:-help}"
shift || true
case "$command_name" in
  start-local) exec "${script_dir}/start-macos.sh" "$@" ;;
  start-wsl2) exec "${script_dir}/start-wsl2.sh" "$@" ;;
  configure-production) exec "${script_dir}/configure-production.sh" "$@" ;;
  start-production) exec "${script_dir}/start-production.sh" "$@" ;;
  status) exec "${script_dir}/status.sh" "$@" ;;
  health) exec "${script_dir}/healthcheck.sh" "$@" ;;
  evidence)
    # shellcheck source=scripts/common.sh
    source "${script_dir}/common.sh"
    initialize_env
    if [[ "$(load_env_value DEPLOYMENT_MODE)" == production ]]; then
      echo "Evidence Workspace: https://$(load_env_value APPLIANCE_HOSTNAME):$(load_env_value HTTPS_PORT)/evidence/"
    else
      echo "Evidence Workspace: http://127.0.0.1:$(load_env_value EVIDENCE_PORT)"
    fi
    echo "Bearer token file: $evidence_token_file"
    ;;
  recover-admin) exec "${script_dir}/recover-admin.sh" "$@" ;;
  repair-local) exec "${script_dir}/repair-macos-runtime.sh" "$@" ;;
  stop) exec "${script_dir}/stop.sh" "$@" ;;
  update-models) exec "${script_dir}/update-model.sh" "$@" ;;
  retire-old-models) exec "${script_dir}/retire-legacy-models.sh" "$@" ;;
  install-native-model) exec "${script_dir}/install-model-native.sh" "$@" ;;
  package-model-bundle) exec "${script_dir}/package-model-bundle.sh" "$@" ;;
  provision-assistants) exec "${script_dir}/provision-assistants.sh" "$@" ;;
  lock-images) exec "${script_dir}/lock-images.sh" "$@" ;;
  scan) exec "${script_dir}/security-scan.sh" "$@" ;;
  backup) exec "${script_dir}/backup.sh" "$@" ;;
  restore) exec "${script_dir}/restore.sh" "$@" ;;
  verify-production) exec "${script_dir}/verify-production-deployment.sh" "$@" ;;
  certify) exec "${script_dir}/certify-production.sh" "$@" ;;
  help|*)
    echo "NetTAP Network Intelligence administration"
    echo "Commands: start-local, start-wsl2, repair-local, configure-production, start-production, status, health, evidence, recover-admin, stop, update-models, retire-old-models, install-native-model, package-model-bundle, provision-assistants, lock-images, scan, backup, restore, verify-production, certify"
    ;;
esac
