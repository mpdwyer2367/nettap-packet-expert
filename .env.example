# Bootstrap tags. Production startup rejects tags until lock-images.sh replaces
# each value with the platform-specific immutable repository digest.
RELEASE_VERSION=0.3.0-rc.1
OLLAMA_IMAGE=ollama/ollama:0.32.5
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0
CADDY_IMAGE=caddy:2.11.4-alpine
BACKUP_IMAGE=alpine:3.24.1

MODEL_NAME=nettap-packet-expert:latest
EXPECTED_BASE_MODEL_ID=500a1f067a9f
DEPLOYMENT_MODE=local
BIND_ADDRESS=127.0.0.1
WEB_PORT=3001
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=8443
APPLIANCE_HOSTNAME=packet-expert.local
WEBUI_SECRET_KEY=GENERATE_ON_FIRST_START
JWT_EXPIRES_IN=8h

OLLAMA_CPUS=6
OLLAMA_MEMORY=8g
WEBUI_CPUS=2
WEBUI_MEMORY=3g
GATEWAY_CPUS=1
GATEWAY_MEMORY=512m

# A unique bootstrap password is generated locally and never committed.
WEBUI_ADMIN_NAME=NetTAP Administrator
WEBUI_ADMIN_EMAIL=admin@nettap.local
WEBUI_ADMIN_PASSWORD=GENERATE_ON_FIRST_START
