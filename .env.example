# Bootstrap tags. Production startup rejects tags until lock-images.sh replaces
# each value with the platform-specific immutable repository digest.
RELEASE_VERSION=0.4.0-rc.1
OLLAMA_IMAGE=ollama/ollama:0.32.5
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0
CADDY_IMAGE=caddy:2.11.4-alpine
BACKUP_IMAGE=alpine:3.24.1

BASE_MODEL=qwen3.5:9b-q4_K_M
NETTAP_AI_MODEL=nettap-ai:0.4.0-rc.1
# Backward-compatible alias used by older administration scripts.
MODEL_NAME=nettap-ai:0.4.0-rc.1
EXPECTED_BASE_MODEL_ID=6488c96fa5fa
RETIRE_LEGACY_NETTAP_MODELS=true
NETTAP_VISIBILITY_PROFILE=nettap-network-visibility
NETTAP_PACKET_EXPERT_PROFILE=nettap-packet-expert
RAG_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
RAG_EMBEDDING_MODEL=/app/backend/data/nettap-models/all-MiniLM-L6-v2/1110a243fdf4706b3f48f1d95db1a4f5529b4d41
DEPLOYMENT_MODE=local
BIND_ADDRESS=127.0.0.1
WEB_PORT=3100
VISIBILITY_LAUNCHER_PORT=3000
PACKET_EXPERT_LAUNCHER_PORT=3001
EVIDENCE_PORT=3200
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=8443
APPLIANCE_HOSTNAME=nettap-ai.local
WEBUI_SECRET_KEY=GENERATE_ON_FIRST_START
JWT_EXPIRES_IN=8h

OLLAMA_CPUS=6
OLLAMA_MEMORY=12g
# Load only the managed NetTAP runtime model and avoid context-cache
# multiplication on laptop-class Docker deployments.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_QUEUE=8
OLLAMA_KEEP_ALIVE=2m
WEBUI_CPUS=2
WEBUI_MEMORY=3g
EVIDENCE_CPUS=1
EVIDENCE_MEMORY=512m
EVIDENCE_MAX_UPLOAD_BYTES=104857600
EVIDENCE_MAX_RECORDS=100000
GATEWAY_CPUS=1
GATEWAY_MEMORY=512m

# Local evaluation starts with a documented default account. Production rejects it.
WEBUI_ADMIN_NAME=NetTAP Administrator
WEBUI_ADMIN_EMAIL=admin@nettaptech.com
WEBUI_ADMIN_PASSWORD=Password!
EVIDENCE_API_TOKEN=GENERATE_ON_FIRST_START
