{
	admin off
	auto_https off
}

:443 {
	tls /etc/caddy/tls/tls.crt /etc/caddy/tls/tls.key
	encode zstd gzip
	@network_visibility path /visibility
	redir @network_visibility /visibility/ 308
	@network_visibility_open path /visibility/open
	redir @network_visibility_open "/?model={$NETTAP_VISIBILITY_PROFILE}&q=Begin%20in%20Network%20%26%20Visibility%20mode.%20Ask%20one%20simple%20question%20to%20understand%20my%20network%20goal." 302
	@network_visibility_start path /visibility/start
	redir @network_visibility_start "/?model={$NETTAP_VISIBILITY_PROFILE}&q=Use%20Network%20%26%20Visibility%20mode.%20I%27m%20not%20sure%20where%20to%20begin.%20Ask%20me%20one%20simple%20question%20at%20a%20time%20to%20understand%20my%20network%2C%20my%20goal%2C%20and%20what%20information%20is%20available." 302
	@network_visibility_design path /visibility/design
	redir @network_visibility_design "/?model={$NETTAP_VISIBILITY_PROFILE}&q=Use%20Network%20%26%20Visibility%20mode.%20Help%20me%20design%20or%20improve%20my%20network.%20Ask%20for%20the%20minimum%20environment%20details%20you%20need." 302
	@network_visibility_connect path /visibility/connect
	redir @network_visibility_connect "/?model={$NETTAP_VISIBILITY_PROFILE}&q=Use%20Network%20%26%20Visibility%20mode.%20Help%20me%20choose%20how%20to%20add%20NetTAP%20visibility%20and%20collect%20the%20right%20traffic%20or%20telemetry%20for%20my%20goal." 302
	@packet_expert path /packet-expert
	redir @packet_expert /packet-expert/ 308
	@packet_expert_open path /packet-expert/open
	redir @packet_expert_open "/?model={$NETTAP_PACKET_EXPERT_PROFILE}&q=Begin%20in%20Packet%20Expert%20mode.%20Ask%20one%20simple%20question%20to%20define%20my%20authorized%20investigation." 302
	@packet_expert_start path /packet-expert/start
	redir @packet_expert_start "/?model={$NETTAP_PACKET_EXPERT_PROFILE}&q=Use%20Packet%20Expert%20mode.%20I%20have%20a%20network%20or%20security%20issue%20but%20do%20not%20know%20what%20evidence%20I%20need.%20Ask%20me%20one%20simple%20question%20at%20a%20time." 302
	@packet_expert_evidence path /packet-expert/evidence
	redir @packet_expert_evidence "/?model={$NETTAP_PACKET_EXPERT_PROFILE}&q=Use%20Packet%20Expert%20mode.%20Help%20me%20understand%20what%20packet-derived%20evidence%20is%20actually%20available%20and%20what%20it%20can%20prove." 302
	@packet_expert_capture path /packet-expert/capture
	redir @packet_expert_capture "/?model={$NETTAP_PACKET_EXPERT_PROFILE}&q=Use%20Packet%20Expert%20mode.%20Help%20me%20plan%20a%20safe%2C%20authorized%20capture%20for%20my%20investigation%20without%20assuming%20a%20capture%20already%20exists." 302
	@system_health path /system/health
	handle @system_health {
		rewrite * /health
		reverse_proxy open-webui:8080
	}
	handle_path /ui/* {
		root * /srv
		file_server
	}
	handle_path /visibility/* {
		root * /srv/network-visibility
		try_files {path} /index.html
		file_server
	}
	handle_path /packet-expert/* {
		root * /srv/packet-expert
		try_files {path} /index.html
		file_server
	}
	@evidence_root path /evidence
	redir @evidence_root /evidence/ 308
	handle_path /evidence/* {
		reverse_proxy evidence-service:8081
	}
	reverse_proxy open-webui:8080
	request_body {
		max_size 100MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	log {
		output stdout
		format json
	}
}
