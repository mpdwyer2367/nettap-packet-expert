{
	admin off
	auto_https off
}

:443 {
	tls /etc/caddy/tls/tls.crt /etc/caddy/tls/tls.key
	encode zstd gzip
	@network_visibility path /visibility
	redir @network_visibility "/?model={$NETTAP_AI_MODEL}&q=Begin%20in%20Network%20%26%20Visibility%20mode.%20Ask%20one%20simple%20question%20to%20understand%20my%20network%20goal." 302
	@packet_expert path /packet-expert
	redir @packet_expert "/?model={$NETTAP_AI_MODEL}&q=Begin%20in%20Packet%20Expert%20mode.%20Ask%20one%20simple%20question%20to%20define%20my%20authorized%20investigation." 302
	reverse_proxy open-webui:8080
	request_body {
		max_size 100MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	log {
		output stdout
		format json
	}
}
