# AMDAI capacity profile: xl
# Matches src/lib/capacity.ts CAPACITY_PROFILES["xl"].requires: 32 vCPU / 128 GB RAM / 4,000 GB disk
# 10 Gbps line-rate metadata extraction, 200k+ flows/s.
AMDAI_PROFILE=xl

# --- Postgres/TimescaleDB tuning ---
PG_SHARED_BUFFERS=32GB
PG_EFFECTIVE_CACHE_SIZE=96GB
PG_WORK_MEM=128MB
PG_MAX_WAL_SIZE=32GB
PG_MAX_CONNECTIONS=400
PG_WAL_COMPRESSION=on

# --- Container CPU/memory reservations & limits (of the 32 vCPU / 128 GB host) ---
PG_CPU_LIMIT=10
PG_MEM_RESERVATION=40g
PG_MEM_LIMIT=56g

COLLECTOR_CPU_LIMIT=18
COLLECTOR_MEM_RESERVATION=24g
COLLECTOR_MEM_LIMIT=40g

WEB_CPU_LIMIT=2
WEB_MEM_RESERVATION=1g
WEB_MEM_LIMIT=4g

OLLAMA_CPU_LIMIT=4
OLLAMA_MEM_LIMIT=24g
