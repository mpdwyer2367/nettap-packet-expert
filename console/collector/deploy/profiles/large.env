# AMDAI capacity profile: large
# Matches src/lib/capacity.ts CAPACITY_PROFILES["large"].requires: 16 vCPU / 64 GB RAM / 2,000 GB disk
# Aggregated NPB feed, multi-site flow export. ~120,000 flows/s, ~5 Gbps sustained capture.
AMDAI_PROFILE=large

# --- Postgres/TimescaleDB tuning ---
PG_SHARED_BUFFERS=16GB
PG_EFFECTIVE_CACHE_SIZE=48GB
PG_WORK_MEM=64MB
PG_MAX_WAL_SIZE=16GB
PG_MAX_CONNECTIONS=300
PG_WAL_COMPRESSION=on

# --- Container CPU/memory reservations & limits (of the 16 vCPU / 64 GB host) ---
PG_CPU_LIMIT=6
PG_MEM_RESERVATION=20g
PG_MEM_LIMIT=28g

COLLECTOR_CPU_LIMIT=8
COLLECTOR_MEM_RESERVATION=12g
COLLECTOR_MEM_LIMIT=20g

WEB_CPU_LIMIT=1.5
WEB_MEM_RESERVATION=1g
WEB_MEM_LIMIT=3g

OLLAMA_CPU_LIMIT=2
OLLAMA_MEM_LIMIT=12g
