# AMDAI capacity profile: medium
# Matches src/lib/capacity.ts CAPACITY_PROFILES["medium"].requires: 8 vCPU / 32 GB RAM / 1,000 GB disk
# Single data-center vantage. ~50,000 flows/s, ~1 Gbps sustained capture.
AMDAI_PROFILE=medium

# --- Postgres/TimescaleDB tuning ---
PG_SHARED_BUFFERS=8GB
PG_EFFECTIVE_CACHE_SIZE=24GB
PG_WORK_MEM=32MB
PG_MAX_WAL_SIZE=8GB
PG_MAX_CONNECTIONS=200
PG_WAL_COMPRESSION=on

# --- Container CPU/memory reservations & limits (of the 8 vCPU / 32 GB host) ---
PG_CPU_LIMIT=3
PG_MEM_RESERVATION=10g
PG_MEM_LIMIT=14g

COLLECTOR_CPU_LIMIT=3.5
COLLECTOR_MEM_RESERVATION=6g
COLLECTOR_MEM_LIMIT=10g

WEB_CPU_LIMIT=1
WEB_MEM_RESERVATION=512m
WEB_MEM_LIMIT=2g

OLLAMA_CPU_LIMIT=1.5
OLLAMA_MEM_LIMIT=6g
