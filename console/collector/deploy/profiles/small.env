# AMDAI capacity profile: small
# Matches src/lib/capacity.ts CAPACITY_PROFILES["small"].requires: 4 vCPU / 8 GB RAM / 100 GB disk
# Branch office or lab VM. ~5,000 flows/s, ~200 Mbps sustained capture.
AMDAI_PROFILE=small

# --- Postgres/TimescaleDB tuning (passed as -c flags in docker-compose.yml) ---
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_WORK_MEM=16MB
PG_MAX_WAL_SIZE=2GB
PG_MAX_CONNECTIONS=100
PG_WAL_COMPRESSION=on

# --- Container CPU/memory reservations & limits (of the 4 vCPU / 8 GB host) ---
PG_CPU_LIMIT=1.5
PG_MEM_RESERVATION=2g
PG_MEM_LIMIT=3g

COLLECTOR_CPU_LIMIT=1.5
COLLECTOR_MEM_RESERVATION=1g
COLLECTOR_MEM_LIMIT=2g

WEB_CPU_LIMIT=0.5
WEB_MEM_RESERVATION=256m
WEB_MEM_LIMIT=1g

OLLAMA_CPU_LIMIT=0.5
OLLAMA_MEM_LIMIT=2g
