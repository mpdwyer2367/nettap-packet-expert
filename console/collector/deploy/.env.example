# NetTAP collector appliance example configuration.
# Copy this file to .env, replace every CHANGE_ME value, and set mode 0600.
# Internal AMDAI_* names are retained for compatibility with the collector code.

AMDAI_PROFILE=small
AMDAI_CONSOLE_URL=https://net-chat-insight.lovable.app
AMDAI_COLLECTOR_TOKEN=CHANGE_ME_SINGLE_USE_PAIRING_TOKEN
AMDAI_API_PORT=8787

POSTGRES_USER=amdai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_UNIQUE_DATABASE_PASSWORD
POSTGRES_DB=amdai_collector
AMDAI_LOCAL_PG=postgresql://amdai:CHANGE_ME_STRONG_UNIQUE_DATABASE_PASSWORD@127.0.0.1:5432/amdai_collector

WEB_PORT=8443
OLLAMA_MODEL=llama3.1:8b

