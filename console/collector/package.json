{
  "name": "@amdai/collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AMDAI Collector appliance: NetFlow/IPFIX/sFlow, packet capture, SNMP/ICMP/WMI probes, and console uplink.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate:schema": "tsx scripts/validate-schema.ts"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "pg-copy-streams": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
